{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/", "/:path(.*\\.html)", "/index.php", "/dash/login.php", "/dash/index.php"]
  },
  "redirects": [
    { "source": "/blog", "destination": "/blog.html", "permanent": true },
    { "source": "/blog/", "destination": "/blog.html", "permanent": true },
    { "source": "/plans", "destination": "/plans.html", "permanent": true },
    { "source": "/plans/", "destination": "/plans.html", "permanent": true },
    { "source": "/status", "destination": "/status.html", "permanent": true },
    { "source": "/status/", "destination": "/status.html", "permanent": true },
    { "source": "/server-status", "destination": "/status.html", "permanent": true },
    { "source": "/server-status/", "destination": "/status.html", "permanent": true },
    { "source": "/faq", "destination": "/faq.html", "permanent": true },
    { "source": "/faq/", "destination": "/faq.html", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/about/", "destination": "/about.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy.html", "permanent": true },
    { "source": "/docs", "destination": "/docs.html", "permanent": true },
    { "source": "/docs/", "destination": "/docs.html", "permanent": true },
    { "source": "/features", "destination": "/#why", "permanent": true },
    { "source": "/features/", "destination": "/#why", "permanent": true },
    { "source": "/features.html", "destination": "/#why", "permanent": true },
    { "source": "/security.txt", "destination": "/.well-known/security.txt", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/markdown.js": { "maxDuration": 10, "includeFiles": "markdown/**" },
    "api/uptime.js": { "maxDuration": 30 },
    "api/plans.js": { "maxDuration": 10 },
    "api/faqs.js": { "maxDuration": 10 },
    "api/features.js": { "maxDuration": 10 },
    "api/testimonials.js": { "maxDuration": 10 }
  }
}
