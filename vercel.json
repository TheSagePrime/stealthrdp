{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/", "/:path(.*\\.html)", "/index.php", "/dash/login.php", "/dash/index.php", "/dash/index.php/:path*", "/:path*"]
  },
  "redirects": [
    { "source": "/docs/1737944563-how-to-re_activate-and-extend-your-180_day-windows-trial.html", "destination": "/docs/how-to-re-activate-and-extend-your-180-day-windows-trial", "permanent": true },
    { "source": "/docs/1737946054-how-to-setup-your-vpn-on-linux-server-using-outline.html", "destination": "/docs/how-to-setup-your-vpn-on-linux-server-using-outline", "permanent": true },
    { "source": "/docs/1737946569-install-fast-panel-in-linux-good-web-hosting-free-panel.html", "destination": "/docs/install-fast-panel-in-linux-good-web-hosting-free-panel", "permanent": true },
    { "source": "/docs/1737944013-use-of-service.html", "destination": "/docs/use-of-service", "permanent": true },
    { "source": "/docs/1737946470-how-to-install-centos-web-panel-cwp-free-web-panel.html", "destination": "/docs/how-to-install-centos-web-panel-cwp-free-web-panel", "permanent": true },
    { "source": "/docs/1737946390-setup-tun-tap-for-open_vpn.html", "destination": "/docs/setup-tun-tap-for-open-vpn", "permanent": true },
    { "source": "/docs/1737943955-introduction.html", "destination": "/docs/introduction", "permanent": true },
    { "source": "/docs/1737944110-termination-of-service.html", "destination": "/docs/termination-of-service", "permanent": true },
    { "source": "/docs/1737944184-payment-terms.html", "destination": "/docs/payment-terms", "permanent": true },
    { "source": "/docs/1737944204-user-responsibilities.html", "destination": "/docs/user-responsibilities", "permanent": true },
    { "source": "/docs/1737944952-server-stops-randomly.html", "destination": "/docs/server-stops-randomly", "permanent": true },
    { "source": "/docs/1737945157-how-do-i-log-into-windows.html", "destination": "/docs/how-do-i-log-into-windows", "permanent": true },
    { "source": "/docs/1737945947-how-to-force-https-using-htaccess.html", "destination": "/docs/how-to-force-https-using-htaccess", "permanent": true },
    { "source": "/docs/1737945988-why-you-should-redirect-all-http-traffic-to-https.html", "destination": "/docs/why-you-should-redirect-all-http-traffic-to-https", "permanent": true },
    { "source": "/docs/1737946010-10-ways-to-optimize-your-word_press-website-for-speed.html", "destination": "/docs/10-ways-to-optimize-your-word-press-website-for-speed", "permanent": true },
    { "source": "/docs/1737946490-how-to-install-direct-admin-in-a-linux-server.html", "destination": "/docs/how-to-install-direct-admin-in-a-linux-server", "permanent": true },
    { "source": "/docs/1737946509-install-cpanel-and-whm-in-linux-you-need-a-license.html", "destination": "/docs/install-cpanel-and-whm-in-linux-you-need-a-license", "permanent": true },
    { "source": "/docs/1737946534-install-cyber-panel-with-open_lite_speed-in-linux.html", "destination": "/docs/install-cyber-panel-with-open-lite-speed-in-linux", "permanent": true },
    { "source": "/docs/1737948398-frequently-asked-questions-fa_qs.html", "destination": "/docs/frequently-asked-questions-fa-qs", "permanent": true },
    { "source": "/docs/1740916941-how-to-rebuild-a-server.html", "destination": "/docs/how-to-rebuild-a-server", "permanent": true },
    { "source": "/docs/1740917234-how-to-reset-server-change-or-reset-client-area-password.html", "destination": "/docs/how-to-reset-server-change-or-reset-client-area-password", "permanent": true },
    { "source": "/docs/1742181117-step_by_step-guide-to-fix-win_rm-and-install-net-framework.html", "destination": "/docs/step-by-step-guide-to-fix-win-rm-and-install-net-framework", "permanent": true },
    { "source": "/docs/1737944563-how-to_re_activate-and-extend-your-180_day-windows-trial.html", "destination": "/docs/how-to-re-activate-and-extend-your-180-day-windows-trial", "permanent": true },

    { "source": "/docs.html", "destination": "/docs", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/plans.html", "destination": "/plans", "permanent": true },
    { "source": "/status.html", "destination": "/status", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/docs/", "destination": "/docs", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/plans/", "destination": "/plans", "permanent": true },
    { "source": "/status/", "destination": "/status", "permanent": true },
    { "source": "/faq/", "destination": "/faq", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/windows-vps", "destination": "/windows-vps/", "permanent": true },
    { "source": "/linux-vps", "destination": "/linux-vps/", "permanent": true },
    { "source": "/server-status", "destination": "/status", "permanent": true },
    { "source": "/server-status/", "destination": "/status", "permanent": true },
    { "source": "/features", "destination": "/#why", "permanent": true },
    { "source": "/features/", "destination": "/#why", "permanent": true },
    { "source": "/features.html", "destination": "/#why", "permanent": true },
    { "source": "/security.txt", "destination": "/.well-known/security.txt", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/markdown.js": { "maxDuration": 10, "includeFiles": "markdown/**" },
    "api/uptime.js": { "maxDuration": 30 },
    "api/plans.js": { "maxDuration": 10 },
    "api/faqs.js": { "maxDuration": 10 },
    "api/features.js": { "maxDuration": 10 },
    "api/testimonials.js": { "maxDuration": 10 }
  }
}
