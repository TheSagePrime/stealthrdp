{
  "name": "stealthrdp-site",
  "version": "2.0.0",
  "private": true,
  "description": "StealthRDP v2 — Stealth Control Room marketing site (static, SEO-prerendered)",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "vercel-build": "node build.mjs && node scripts/bake-base.mjs && node scripts/build-markdown.mjs && node scripts/stage-vercel-public.mjs",
    "test": "node --test test/*.test.js",
    "start": "node server.js",
    "check": "node --test test/*.test.js",
    "seo:check": "SEO_CHANGED_ONLY=1 node scripts/seo-gates.mjs",
    "preview:check": "node scripts/check-preview.mjs",
    "live:check": "node scripts/check-live.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@vercel/functions": "3.9.3",
    "turndown": "7.2.4"
  }
}
